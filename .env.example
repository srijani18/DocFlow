# DocFlow environment variables.
#
# Local development: copy this file to `.env` at the repo root. Both apps read it
# (the API via pydantic-settings, the web app via next.config.ts).
# Never commit `.env`. Secret values go only in Render (API) or Vercel (web) dashboards.
#
# Legend: [secret] = must never be committed or exposed to the browser.

# ======================================================================== API (Render)

# Which parts of the monolith this process runs: api | worker | all  (Render: all)
ROLE=all
# local | test | production
ENVIRONMENT=local
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# HTTP port. Render injects PORT automatically.
PORT=8000

# [secret] Postgres for the app AND migrations (ADR-0007). Local: docker compose.
# Production: Supabase -> Connect -> "Session pooler" (port 5432, user postgres.<ref>).
DATABASE_URL=postgresql://postgres:postgres@localhost:54320/docflow

# Supabase project URL (Project Settings -> API Keys). Token issuer and JWKS URL derive from it.
SUPABASE_URL=https://your-project-ref.supabase.co
# Expected `aud` claim of Supabase access tokens.
AUTH_JWT_AUDIENCE=authenticated
# How long verified signing keys are cached, in seconds (F1 AC12).
AUTH_JWKS_CACHE_TTL_SECONDS=600

# [secret] Supabase -> Project Settings -> API Keys -> secret key (sb_secret_...). Storage only.
SUPABASE_SECRET_KEY=
# Private bucket for uploads: documents-dev locally, documents in production (ADR-0004).
SUPABASE_STORAGE_BUCKET=documents-dev

# [secret] Google AI Studio API key (free tier). Only sample/synthetic documents (constitution §5.5).
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# Timeout for one LLM call, in seconds.
LLM_TIMEOUT_SECONDS=60
# Model and prompt version per task (F4, F5).
LLM_CLASSIFY_MODEL=gemini-flash-lite-latest
LLM_CLASSIFY_PROMPT=classify/v1

# Comma-separated exact origins allowed to call the API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Optional regex for Vercel preview URLs, e.g. ^https://docflow-[a-z0-9-]+-yourscope\.vercel\.app$
CORS_ALLOWED_ORIGIN_REGEX=

# ======================================================================== Web (Vercel)

# Public by design: these are embedded in the browser bundle.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Same value as SUPABASE_URL above.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase -> Project Settings -> API Keys -> "Publishable key" (sb_publishable_...).
# Not a secret: it only identifies the project. Never put the sb_secret_ key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me

# ======================================================================== Local tooling only

# Host port for docker compose Postgres (default 54320).
DOCFLOW_PG_PORT=54320
# Test database used by `make api-test` (integration tests).
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:54320/docflow_test
