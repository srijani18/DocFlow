{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.docflow.dev/common/party.json",
  "title": "Party",
  "description": "A seller, buyer or merchant.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "gstin",
    "address"
  ],
  "properties": {
    "name": {
      "type": [
        "string",
        "null"
      ],
      "description": "Legal or trading name.",
      "x-eval": "fuzzy"
    },
    "gstin": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z]$",
      "description": "15-character Indian GSTIN, or null if absent.",
      "x-eval": "exact"
    },
    "address": {
      "anyOf": [
        {
          "$ref": "address.json"
        },
        {
          "type": "null"
        }
      ],
      "description": "Postal address, or null if absent."
    }
  }
}
